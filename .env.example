# 币安 USDT-M（仅需合约权限；勿开提现）
BINANCE_API_KEY=
BINANCE_API_SECRET=
# false=主网（binance.com 密钥）；true=模拟盘 demo-fapi（密钥来自 https://demo.binance.com）
BINANCE_TESTNET=false

# 可选：访问 fapi.binance.com 超时时走代理（451 地区限制、防火墙）
# 本机 Clash HTTP: http://127.0.0.1:7890 | SSR SOCKS5: socks5://127.0.0.1:1080（需 PySocks）
# Docker 容器访问宿主机 Clash: http://host.docker.internal:7890（见 docker-compose extra_hosts）
BINANCE_HTTPS_PROXY=

# 大模型（OpenAI 兼容 SDK）。DeepSeek 示例 — OpenAI 请改 api.openai.com 与对应密钥
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_TIMEOUT_SEC=120
OPENAI_MAX_RETRIES=4
OPENAI_RETRY_BASE_SEC=1

# 信号源：llm（OPENAI_*）或 strategy（规则；名称同 binance-auto-backtest --strategy）
SIGNAL_SOURCE=strategy
# sma_cross | rsi | rsi_adaptive | macd | bollinger | bb | ichimoku | ichi | fibonacci | fib | volume_profile | vp |
# stochastic | stoch | atr_breakout | atr | ml | composite | rl_sb3
STRATEGY_NAME=sma_cross
STRATEGY_FAST=10
STRATEGY_SLOW=30
# 配合 POSITION_SIZING=equity_leverage：保证金 = 全部权益 × 该值%（如 5 = 每单用 5% 权益作保证金）
STRATEGY_SIZE_PCT=5
STRATEGY_CONFIDENCE=0.8
STRATEGY_RSI_PERIOD=14
STRATEGY_RSI_OVERSOLD=30
STRATEGY_RSI_OVERBOUGHT=70
STRATEGY_MACD_SIGNAL=9
STRATEGY_BB_PERIOD=20
STRATEGY_BB_STD=2

# 其他规则策略参数（见上方 STRATEGY_NAME 列表）
STRATEGY_ICHIMOKU_TENKAN=9
STRATEGY_ICHIMOKU_KIJUN=26
STRATEGY_ICHIMOKU_SENKOU_B=52
STRATEGY_FIB_LOOKBACK=50
# 0.382 | 0.5 | 0.618
STRATEGY_FIB_LEVEL=0.618
STRATEGY_VP_BARS=48
STRATEGY_VP_BINS=24

STRATEGY_STOCH_K=14
STRATEGY_STOCH_D=3
STRATEGY_STOCH_OVERSOLD=20
STRATEGY_STOCH_OVERBOUGHT=80

STRATEGY_ATR_PERIOD=14
STRATEGY_ATR_MULT=1.5

# ML 策略（STRATEGY_NAME=ml）：pip install -e ".[ml-torch]" 或 ".[ml-tf]"
ML_BACKEND=torch
# mlp | lstm | transformer（PyTorch TorchScript；TensorFlow 仅 mlp 平铺头）
ML_TORCH_ARCH=mlp
# TorchScript（.pt）或 Keras（.keras）模型路径
ML_MODEL_PATH=
STRATEGY_ML_WINDOW=32
ML_HOT_RELOAD=true
ML_HOT_RELOAD_INTERVAL_SEC=30

# --- 组合策略（STRATEGY_NAME=composite）：子策略共用同一套参数
# COMPOSITE_MODE=majority | weighted | unanimous | first
COMPOSITE_MEMBERS=
COMPOSITE_MODE=majority
# COMPOSITE_MODE=weighted 时每个成员一个权重（省略则均权）
COMPOSITE_WEIGHTS=

# --- rsi_adaptive：按已实现波动率放宽/收紧 RSI 带（基准见 STRATEGY_RSI_*）
STRATEGY_VOL_WINDOW=20
STRATEGY_VOL_REF_WINDOW=100
STRATEGY_VOL_SENSITIVITY=10

# --- RL（STRATEGY_NAME=rl_sb3）：pip install -e ".[rl]"；训练见 examples/train_rl_sb3.py
# 观测 (RL_WINDOW-1,) 裁剪对数收益；动作 0/1/2=观望/做多/做空
RL_MODEL_PATH=
RL_WINDOW=32

# --- 风险分析（可选实盘门控）：历史收益 VaR + 辅助品种对数收益相关性日志
RISK_VAR_WINDOW=0
RISK_VAR_ALPHA=0.05
RISK_VAR_BLOCK=false
RISK_VAR_TAIL_LIMIT=-0.02
RISK_CORR_AUX_SYMBOL=
RISK_CORR_LOG_EVERY=20
# 离线验证滚动 VaR：binance-auto-var-validate --fetch --lookback 250 --alpha 0.05

# pip install -e ".[realtime]" — 已收盘 K 线并入规则循环（仅 SIGNAL_SOURCE=strategy）
USE_WEBSOCKET=false
WS_RECONNECT_BASE_SEC=1
WS_RECONNECT_MAX_SEC=60
WS_RECONNECT_JITTER=0.25

# Telegram（可选）：使用 secrets/telegram_bot_token + secrets/telegram_chat_id
# 本地：复制 deploy/telegram.credentials.example -> deploy/telegram.credentials，再执行
#   .\scripts\install-telegram-secrets.ps1
# 勿在此写空 TELEGRAM_BOT_TOKEN — 会阻止 Docker 读取 secret 文件
# default | compact | oneline | html（html 模板配合 TELEGRAM_PARSE_MODE=HTML）
TELEGRAM_TEMPLATE=default
# 完全自定义模板（Python format，占位符见 telegram_format.build_trade_context）
TELEGRAM_MESSAGE_TEMPLATE=
# 留空 | HTML | Markdown | MarkdownV2
TELEGRAM_PARSE_MODE=
# 信号推送：all | directional（多/空/平，跳过观望）| off
TELEGRAM_NOTIFY_SIGNALS=directional
TELEGRAM_NOTIFY_STARTUP=true
TELEGRAM_NOTIFY_POOL_REFRESH=true
TELEGRAM_NOTIFY_ORDERS=true
TELEGRAM_NOTIFY_ERRORS=true
TELEGRAM_NOTIFY_CG_ALERTS=true
SYMBOL=BTC/USDT:USDT
# single=仅交易 SYMBOL；signal_pick=每分钟从候选池选最强信号，同时只持一仓
SYMBOL_MODE=signal_pick
# auto=按 24h 成交额取 USDT-M 永续前几名（见 SYMBOL_CANDIDATES_*）；或手写：DOGE/USDT:USDT,SOL/USDT:USDT,...
SYMBOL_CANDIDATES=auto
SYMBOL_CANDIDATES_COUNT=6
# 综合排序（rank 百分位归一化加权，抗极值）。可用维度：
#   momentum(=trend，趋势强度 |SMA_fast-SMA_slow|/价，与 STRATEGY_FAST/SLOW、TIMEFRAME 对齐；逐币拉 OHLCV，两段式短名单)
#   liquidity(=24h USDT 成交额) | open_interest | abs_change | change
#   funding(资金费率，带符号) | abs_funding(费率绝对值=拥挤度) | random
#   cg_oi_change(=oi_change，CoinGlass 跨交易所聚合持仓量变化%，需 COINGLASS_API_KEY)
#   cg_top_account_long, cg_top_position_long, cg_global_long, cg_net_position, cg_liq_below, cg_liq_above
#   （CoinGlass 微观结构，仅对流动性短名单逐币拉取，需 COINGLASS_DERIVATIVES_ENABLED）
# 默认让选币与趋势策略对齐：趋势强度为主，流动性/OI 作质量过滤
# 接入 CoinGlass 后推荐：momentum,cg_oi_change,liquidity 权重 0.45,0.35,0.2
SYMBOL_CANDIDATES_RANK_BY=momentum,liquidity,open_interest
SYMBOL_CANDIDATES_RANK_WEIGHTS=0.5,0.3,0.2
# 流动性下限：排序前剔除成交额过低的币（0=关闭）
SYMBOL_CANDIDATES_MIN_QUOTE_VOLUME_USDT=1000000
# 排除清单（逗号分隔）；留空=不排除任何币（含 BTC/ETH）
SYMBOL_CANDIDATES_EXCLUDE=
SYMBOL_CANDIDATES_REFRESH_HOURS=2
# 亚小时刷新；>0 时覆盖上面的 REFRESH_HOURS
SYMBOL_CANDIDATES_REFRESH_MINUTES=0
# 剔除 |24h 涨跌幅| 超过此值的币（0=关闭），避免追暴涨暴跌
SYMBOL_CANDIDATES_MAX_ABS_CHANGE_PCT=30
SYMBOL_CANDIDATES_FILTER_MIN_NOTIONAL=true
# 换币迟滞：新标的置信度需 ≥ 在手仓置信度 + 此值才换币（降低 1m 噪声下的频繁换手）。0=每分钟都可换
SYMBOL_ROTATION_HYSTERESIS=0.05

# --- CoinGlass 衍生品数据（可选选币增强）：pip install -e ".[coinglass]"；key 为空=全部关闭 ---
# 用于：cg_oi_change 维度（加进 RANK_BY）+ 聚合资金费率过滤（剔除过度拥挤的币）
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_TIMEOUT_SEC=10
COINGLASS_CACHE_TTL_SEC=300
# |聚合资金费率| 超过此值的币不入池（单位同 CoinGlass 返回，通常为百分比）。0=关闭
COINGLASS_MAX_ABS_FUNDING_PCT=0
# 清算地图 + 大户/全局多空比 + 净多空（日志/LLM/监控面板；默认开启，需 key）
COINGLASS_DERIVATIVES_ENABLED=true
COINGLASS_EXCHANGE=Binance
# 多空比周期；空=跟随 TIMEFRAME（如 5m）
COINGLASS_LS_INTERVAL=
# 清算地图（Professional+ 套餐；Hobbyist 会 403 并自动跳过）
COINGLASS_LIQ_MAP_ENABLED=true
COINGLASS_LIQ_MAP_RANGE=1d
# --- CoinGlass 链上/流向 Telegram 告警（只通知不下单；需 COINGLASS_API_KEY + Telegram）---
COINGLASS_ALERT_ENABLED=false
COINGLASS_ALERT_INTERVAL_SEC=600
COINGLASS_ALERT_COOLDOWN_SEC=3600
# 24h 现货净流出超过此 USD 绝对值时告警（负 netflow）。0=关闭
COINGLASS_ALERT_NETFLOW_USD=50000000
# 任一交易所 24h 储备增幅 ≥ 此 % 时告警。0=关闭
COINGLASS_ALERT_EXCHANGE_BALANCE_PCT_1D=2
# 链上大额转账告警（USD）；CoinGlass 最小约 $10M。0=关闭
COINGLASS_ALERT_WHALE_USD=10000000
# 额外监控币种（逗号分隔）；默认还会监控候选池与当前持仓
COINGLASS_ALERT_EXTRA_COINS=
# 1m/5m 噪声大、换手贵；蚂蚁仓建议 15m 起
TIMEFRAME=15m
KLINES_LIMIT=120
# fixed = MAX_NOTIONAL_USDT × signal size_pct
# equity_leverage = 钱包 USDT 总权益 × LEVERAGE × size_pct
# available_margin_leverage = 可用 USDT 保证金 × LEVERAGE × size_pct（实盘推荐）
# 「保证金 = 全部权益的 X%」配方：POSITION_SIZING=equity_leverage 且 STRATEGY_SIZE_PCT=X
#   名义 = 权益 × 杠杆 × X%，保证金 = 名义/杠杆 = 权益 × X%（与杠杆无关）
POSITION_SIZING=equity_leverage
# LEVERAGE_MODE：fixed=用下面的 LEVERAGE；max=用该下单币交易所允许的最大杠杆（LEVERAGE 作回退）
LEVERAGE_MODE=fixed
LEVERAGE=10
# 单腿/净敞口硬顶（USDT）。设极大≈不约束，名义由「权益×杠杆×size_pct」与可用保证金决定；按账户规模自行收紧
MAX_NOTIONAL_USDT=100000
DRY_RUN=true
# 趋势策略在 15m 上建议 0.65+，过滤弱信号、配合换币迟滞减少无效换手
MIN_CONFIDENCE=0.65

# --- 主动离场（与策略信号无关，每个 tick 优先判断；按入场价的价格变动 %，0=关闭）---
# 注意：杠杆 L 下对账户权益的影响 ≈ pct × L（如 LEVERAGE=5、止损 2% ≈ 亏 10% 保证金）
# 止损：逆向变动达到此 % 即平仓
EXIT_STOP_LOSS_PCT=0
# 止盈：有利变动达到此 % 即平仓
EXIT_TAKE_PROFIT_PCT=0
# 移动止盈：浮盈曾达到此 % 后，从最高点回撤此 % 即平仓
EXIT_TRAILING_PCT=0
# 持仓超时：持仓达到此分钟数即平仓（进程重启后重新计时）
EXIT_MAX_HOLD_MINUTES=0
# --- 按回报率 ROE = 收益/保证金 = 价格变动% × 杠杆（0=关闭）---
# 止盈：ROE 达到此 % 即平仓。100 = 浮盈达到该仓保证金的 100%
EXIT_TAKE_PROFIT_ROE_PCT=0
# 止损：ROE 跌到 -此 % 即平仓（如 80 = 亏掉 80% 保证金）
EXIT_STOP_LOSS_ROE_PCT=0
# --- CoinGlass 离场（需 COINGLASS_API_KEY；0=关闭，取不到数据自动跳过，不影响价格类止损）---
# OI 骤降离场：有浮盈时聚合 OI 变化% ≤ -此值（仓位快速平掉=趋势衰竭）即落袋
EXIT_CG_OI_DROP_PCT=0
# 逆向资金费率护栏：做多时聚合资金费率 ≥ 此值 / 做空时 ≤ -此值（过度拥挤）即离场（单位同 CoinGlass）
EXIT_CG_ADVERSE_FUNDING=0
# 大户/全局多空比拥挤离场（%）：持多且大户做多%≥该值 / 持空且大户做空%≥该值。0=关闭
EXIT_CG_TOP_ACCOUNT_CROWD_PCT=0
EXIT_CG_TOP_POSITION_CROWD_PCT=0
EXIT_CG_GLOBAL_LONG_CROWD_PCT=0
# 净仓累计与持仓逆向：持多且 net_position_change_cum ≤ -该值 / 持空且 ≥ 该值
EXIT_CG_NET_POSITION_AGAINST=0
# 清算簇磁吸：簇名义≥该 USD 且现价距最近清算价 within DIST%
EXIT_CG_LIQ_CLUSTER_USD=0
EXIT_CG_LIQ_CLUSTER_DIST_PCT=1.0

# 交易所 HTTP 超时（毫秒）与 reduce-only 平仓后持仓同步
EXCHANGE_TIMEOUT_MS=30000
POSITION_POLL_INTERVAL_SEC=0.15
POSITION_POLL_TIMEOUT_SEC=5

# 可选：本地面板 /、/dashboard，/health（JSON），/metrics（Prometheus）。0=关闭
OBSERVABILITY_HOST=127.0.0.1
OBSERVABILITY_PORT=8080

# oneway=单向持仓（推荐）；auto=查询币安；hedge=双向
POSITION_MODE=oneway

# 会话限制（UTC 自然日）。0=关闭。STATE_FILE 非绝对路径时相对仓库根目录
# Docker：STATE_FILE=/app/state/state.json，挂载 ./state:/app/state（见 docker-compose.yml）
MAX_TRADES_PER_DAY=0
MAX_DAILY_LOSS_USDT=0
DAILY_LOSS_WARN_RATIO=0.8
STATE_FILE=.binance_auto_ai_state.json

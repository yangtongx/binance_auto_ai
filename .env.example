# Binance USDT-M (enable Futures permission only is OK; spot/wallet SAPI not required; never enable withdrawal)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# false = mainnet (binance.com API keys). true = demo-fapi (keys from https://demo.binance.com only).
BINANCE_TESTNET=false

# Optional: local proxy when fapi.binance.com times out (mainland / firewall).
# Clash HTTP: http://127.0.0.1:7890 | SSR SOCKS5: socks5://127.0.0.1:1080 (pip install PySocks)
BINANCE_HTTPS_PROXY=

# LLM (OpenAI-compatible SDK). DeepSeek example — use api.openai.com-compatible URL + key for OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_TIMEOUT_SEC=120
OPENAI_MAX_RETRIES=4
OPENAI_RETRY_BASE_SEC=1

# Signals: llm (OPENAI_*) or strategy (rules; names match futures-llm-backtest --strategy)
SIGNAL_SOURCE=strategy
# sma_cross | rsi | rsi_adaptive | macd | bollinger | bb | ichimoku | ichi | fibonacci | fib | volume_profile | vp |
# stochastic | stoch | atr_breakout | atr | ml | composite | rl_sb3
STRATEGY_NAME=sma_cross
STRATEGY_FAST=10
STRATEGY_SLOW=30
STRATEGY_SIZE_PCT=100
STRATEGY_CONFIDENCE=0.8
STRATEGY_RSI_PERIOD=14
STRATEGY_RSI_OVERSOLD=30
STRATEGY_RSI_OVERBOUGHT=70
STRATEGY_MACD_SIGNAL=9
STRATEGY_BB_PERIOD=20
STRATEGY_BB_STD=2

# Extra rule strategies params (see STRATEGY_NAME list above)
STRATEGY_ICHIMOKU_TENKAN=9
STRATEGY_ICHIMOKU_KIJUN=26
STRATEGY_ICHIMOKU_SENKOU_B=52
STRATEGY_FIB_LOOKBACK=50
# 0.382 | 0.5 | 0.618
STRATEGY_FIB_LEVEL=0.618
STRATEGY_VP_BARS=48
STRATEGY_VP_BINS=24

STRATEGY_STOCH_K=14
STRATEGY_STOCH_D=3
STRATEGY_STOCH_OVERSOLD=20
STRATEGY_STOCH_OVERBOUGHT=80

STRATEGY_ATR_PERIOD=14
STRATEGY_ATR_MULT=1.5

# ML strategy (STRATEGY_NAME=ml): pip install -e ".[ml-torch]" or ".[ml-tf]"
ML_BACKEND=torch
# mlp | lstm | transformer (PyTorch TorchScript only; TensorFlow = mlp flat head only)
ML_TORCH_ARCH=mlp
# Path to TorchScript (.pt) or Keras model (.keras)
ML_MODEL_PATH=
STRATEGY_ML_WINDOW=32
ML_HOT_RELOAD=true
ML_HOT_RELOAD_INTERVAL_SEC=30

# --- Composite (STRATEGY_NAME=composite): ensemble of leaf strategies (same param bundle for all children)
# COMPOSITE_MODE=majority | weighted | unanimous | first
COMPOSITE_MEMBERS=
COMPOSITE_MODE=majority
# One weight per member when COMPOSITE_MODE=weighted (omit for equal weights)
COMPOSITE_WEIGHTS=

# --- rsi_adaptive: RSI bands widen/tighten from realized vol (STRATEGY_RSI_* base levels)
STRATEGY_VOL_WINDOW=20
STRATEGY_VOL_REF_WINDOW=100
STRATEGY_VOL_SENSITIVITY=10

# --- RL (STRATEGY_NAME=rl_sb3): pip install -e ".[rl]"; train: python examples/train_rl_sb3.py (obs shape (RL_WINDOW-1,) clipped log-returns; actions 0/1/2 = hold/long/short)
RL_MODEL_PATH=
RL_WINDOW=32

# --- Risk analytics (optional live gate): historical return VaR + aux-symbol log-return correlation logging
RISK_VAR_WINDOW=0
RISK_VAR_ALPHA=0.05
RISK_VAR_BLOCK=false
RISK_VAR_TAIL_LIMIT=-0.02
RISK_CORR_AUX_SYMBOL=
RISK_CORR_LOG_EVERY=20
# Validate rolling VaR vs realized returns: futures-llm-var-validate --fetch --lookback 250 --alpha 0.05

# pip install -e ".[realtime]" — closed klines merged into the rule loop (SIGNAL_SOURCE=strategy only)
USE_WEBSOCKET=false
WS_RECONNECT_BASE_SEC=1
WS_RECONNECT_MAX_SEC=60
WS_RECONNECT_JITTER=0.25

# Telegram (optional): use secrets/telegram_bot_token + secrets/telegram_chat_id
# Local: copy deploy/telegram.credentials.example -> deploy/telegram.credentials, then
#   .\scripts\install-telegram-secrets.ps1
# Do not set empty TELEGRAM_BOT_TOKEN here — it blocks Docker secret files.
# default | compact | oneline | html (use TELEGRAM_PARSE_MODE=HTML with html template)
TELEGRAM_TEMPLATE=default
# Full override with Python format placeholders (see telegram_format.build_trade_context keys)
TELEGRAM_MESSAGE_TEMPLATE=
# blank | HTML | Markdown | MarkdownV2
TELEGRAM_PARSE_MODE=
# Signal pushes: all | directional (long/short/flat, skip hold) | off
TELEGRAM_NOTIFY_SIGNALS=directional
TELEGRAM_NOTIFY_STARTUP=true
TELEGRAM_NOTIFY_POOL_REFRESH=true
TELEGRAM_NOTIFY_ORDERS=true
TELEGRAM_NOTIFY_ERRORS=true
SYMBOL=BTC/USDT:USDT
# single = trade SYMBOL only. signal_pick = strongest rule signal each minute, one position.
SYMBOL_MODE=signal_pick
# auto = top USDT-M perpetuals by 24h quote volume (see SYMBOL_CANDIDATES_*). Or manual: DOGE/USDT:USDT,SOL/USDT:USDT,...
SYMBOL_CANDIDATES=auto
SYMBOL_CANDIDATES_COUNT=5
# Composite rank (normalized 0-1, weighted). liquidity = 24h USDT quote volume.
SYMBOL_CANDIDATES_RANK_BY=abs_change,open_interest,liquidity
SYMBOL_CANDIDATES_RANK_WEIGHTS=0.4,0.3,0.3
# Extra floor: drop illiquid symbols before ranking (0 = off).
SYMBOL_CANDIDATES_MIN_QUOTE_VOLUME_USDT=1000000
SYMBOL_CANDIDATES_EXCLUDE=BTC/USDT:USDT,ETH/USDT:USDT
SYMBOL_CANDIDATES_REFRESH_HOURS=2
SYMBOL_CANDIDATES_FILTER_MIN_NOTIONAL=true
TIMEFRAME=1m
KLINES_LIMIT=120
# fixed = MAX_NOTIONAL_USDT × signal size_pct
# equity_leverage = wallet USDT total × LEVERAGE × size_pct
# available_margin_leverage = available USDT margin × LEVERAGE × size_pct (recommended live)
POSITION_SIZING=available_margin_leverage
LEVERAGE=150
# Hard cap on per-leg / net notional (USDT). With leverage sizing, set above min order (BTC≈80k → min notional ≈80 USDT).
MAX_NOTIONAL_USDT=50
DRY_RUN=true
MIN_CONFIDENCE=0.55

# Exchange HTTP timeout (ms) and position sync after reduce-only closes
EXCHANGE_TIMEOUT_MS=30000
POSITION_POLL_INTERVAL_SEC=0.15
POSITION_POLL_TIMEOUT_SEC=5

# Optional: local dashboard (/, /dashboard), /health (JSON), /metrics (Prometheus). 0 = disabled.
OBSERVABILITY_HOST=127.0.0.1
OBSERVABILITY_PORT=8080

# oneway =单向持仓 (recommended). auto queries Binance; hedge =双向
POSITION_MODE=oneway

# Session limits (UTC calendar day). 0 = disabled. STATE_FILE is relative to repo root if not absolute.
# Docker: use STATE_FILE=/app/state/state.json and mount ./state:/app/state (see docker-compose.yml).
MAX_TRADES_PER_DAY=0
MAX_DAILY_LOSS_USDT=0
DAILY_LOSS_WARN_RATIO=0.8
STATE_FILE=.futures_llm_bot_state.json

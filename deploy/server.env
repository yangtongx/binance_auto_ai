# 服务器模板 — 覆盖本地 .env：./scripts/overwrite-env.sh
# 币安密钥：推荐用 Docker secrets/，或在下方填写 BINANCE_API_*

# 币安 USDT-M（仅需合约权限；现货/钱包 SAPI 不必开；切勿开启提现）
BINANCE_API_KEY=
BINANCE_API_SECRET=
# false=主网（binance.com 密钥）；true=模拟盘 demo-fapi（密钥仅来自 https://demo.binance.com）
BINANCE_TESTNET=false

# 可选：访问 fapi.binance.com 超时时走本地代理（大陆/防火墙）
BINANCE_HTTPS_PROXY=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_TIMEOUT_SEC=120
OPENAI_MAX_RETRIES=4
OPENAI_RETRY_BASE_SEC=1

SIGNAL_SOURCE=strategy
STRATEGY_NAME=sma_cross
STRATEGY_FAST=10
STRATEGY_SLOW=30
# 保证金 = 全部权益 × 5%（配合 POSITION_SIZING=equity_leverage）
STRATEGY_SIZE_PCT=5
STRATEGY_CONFIDENCE=0.8
STRATEGY_RSI_PERIOD=14
STRATEGY_RSI_OVERSOLD=30
STRATEGY_RSI_OVERBOUGHT=70
STRATEGY_MACD_SIGNAL=9
STRATEGY_BB_PERIOD=20
STRATEGY_BB_STD=2
STRATEGY_ICHIMOKU_TENKAN=9
STRATEGY_ICHIMOKU_KIJUN=26
STRATEGY_ICHIMOKU_SENKOU_B=52
STRATEGY_FIB_LOOKBACK=50
STRATEGY_FIB_LEVEL=0.618
STRATEGY_VP_BARS=48
STRATEGY_VP_BINS=24
STRATEGY_STOCH_K=14
STRATEGY_STOCH_D=3
STRATEGY_STOCH_OVERSOLD=20
STRATEGY_STOCH_OVERBOUGHT=80
STRATEGY_ATR_PERIOD=14
STRATEGY_ATR_MULT=1.5
ML_BACKEND=torch
ML_TORCH_ARCH=mlp
ML_MODEL_PATH=
STRATEGY_ML_WINDOW=32
ML_HOT_RELOAD=true
ML_HOT_RELOAD_INTERVAL_SEC=30
COMPOSITE_MEMBERS=
COMPOSITE_MODE=majority
COMPOSITE_WEIGHTS=
STRATEGY_VOL_WINDOW=20
STRATEGY_VOL_REF_WINDOW=100
STRATEGY_VOL_SENSITIVITY=10
RL_MODEL_PATH=
RL_WINDOW=32
RISK_VAR_WINDOW=0
RISK_VAR_ALPHA=0.05
RISK_VAR_BLOCK=false
RISK_VAR_TAIL_LIMIT=-0.02
RISK_CORR_AUX_SYMBOL=
RISK_CORR_LOG_EVERY=20
USE_WEBSOCKET=false
WS_RECONNECT_BASE_SEC=1
WS_RECONNECT_MAX_SEC=60
WS_RECONNECT_JITTER=0.25
# Telegram：服务器执行 bash scripts/install-telegram-secrets.sh -i（写入 secrets/，勿写下面两行）
TELEGRAM_TEMPLATE=default
TELEGRAM_MESSAGE_TEMPLATE=
TELEGRAM_PARSE_MODE=
# 蚂蚁仓：信号不每笔推送（每分钟太吵）；候选池刷新通知保留（30 分钟一次不算吵）
TELEGRAM_NOTIFY_SIGNALS=off
TELEGRAM_NOTIFY_STARTUP=true
TELEGRAM_NOTIFY_POOL_REFRESH=true
TELEGRAM_NOTIFY_ORDERS=true
TELEGRAM_NOTIFY_ERRORS=true

# === 选币：自动 · 主流偏向 · 30 分钟刷新 ===
SYMBOL=BTC/USDT:USDT
SYMBOL_MODE=signal_pick
SYMBOL_CANDIDATES=auto
SYMBOL_CANDIDATES_COUNT=6
# 蚂蚁仓权重：趋势强度为主（与 SMA 策略对齐），流动性/OI 作质量过滤
# momentum=|SMA_fast-SMA_slow|/价（用 STRATEGY_FAST/SLOW 与 TIMEFRAME，逐币短名单拉 OHLCV）
# 可选加资金费率：把 abs_funding 加进 RANK_BY 并给权重
# 接入 CoinGlass 聚合持仓量变化(cg_oi_change)确认趋势有真金白银跟随
SYMBOL_CANDIDATES_RANK_BY=momentum,cg_oi_change,liquidity
SYMBOL_CANDIDATES_RANK_WEIGHTS=0.45,0.35,0.2
SYMBOL_CANDIDATES_MIN_QUOTE_VOLUME_USDT=2000000
# 留空=不排除任何币（含 BTC/ETH）
SYMBOL_CANDIDATES_EXCLUDE=
SYMBOL_CANDIDATES_REFRESH_HOURS=2
# 30 分钟刷新一次（蚂蚁仓不追异动，不需要分钟级）
SYMBOL_CANDIDATES_REFRESH_MINUTES=30
SYMBOL_CANDIDATES_FILTER_MIN_NOTIONAL=true
# 暴涨/暴跌币黑名单：24h |涨跌幅| 超过此值（百分比）的币不入池。0 = 关闭。
# 蚂蚁仓建议 30~50，避免追暴涨暴跌
SYMBOL_CANDIDATES_MAX_ABS_CHANGE_PCT=30
# 换币迟滞：新标的置信度需 ≥ 在手仓 + 此值才换币（降低 1m/5m 噪声下的频繁换手，省手续费/滑点）
SYMBOL_ROTATION_HYSTERESIS=0.05

# === CoinGlass 衍生品数据（需 pip install -e ".[coinglass]" 与 COINGLASS_API_KEY；建议用 Docker secret 注入）===
# 把 key 写进 secrets/coinglass_api_key 或环境变量 COINGLASS_API_KEY；为空则 cg_oi_change 维度与资金费率过滤自动关闭
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_TIMEOUT_SEC=10
COINGLASS_CACHE_TTL_SEC=300
# 聚合资金费率过滤：剔除过度拥挤（易插针爆仓）的币。单位同 CoinGlass 返回（通常百分比）；先观察日志再校准
COINGLASS_MAX_ABS_FUNDING_PCT=0.05
# === CoinGlass 链上/流向 Telegram 告警（只通知，不下单/不改策略）===
COINGLASS_ALERT_ENABLED=true
COINGLASS_ALERT_INTERVAL_SEC=600
COINGLASS_ALERT_COOLDOWN_SEC=3600
# 24h 现货净流出超过 5000 万 USD 告警；交易所储备 24h 增 ≥2% 告警；链上转账 ≥1000 万 USD 告警
COINGLASS_ALERT_NETFLOW_USD=50000000
COINGLASS_ALERT_EXCHANGE_BALANCE_PCT_1D=2
COINGLASS_ALERT_WHALE_USD=10000000
COINGLASS_ALERT_EXTRA_COINS=BTC,ETH
TELEGRAM_NOTIFY_CG_ALERTS=true
# 5m 比 1m 噪声小、换手省；蚂蚁仓更稳
TIMEFRAME=5m
KLINES_LIMIT=120

# === 仓位：保证金=全部权益5% + 每币最大杠杆 ===
# 保证金 = 全部权益 × STRATEGY_SIZE_PCT%（=5%）；名义 = 保证金 × 杠杆
POSITION_SIZING=equity_leverage
# max=用该下单币交易所允许的最大杠杆（LEVERAGE 仅作取不到时的回退）
LEVERAGE_MODE=max
LEVERAGE=20
# 安全总顶（USDT）。设极大≈不约束，实际名义由 5% 权益×最大杠杆 决定；按账户规模自行收紧
MAX_NOTIONAL_USDT=100000
# false = 真实下单（币安 USDT-M 主网）；true = 仅模拟日志
DRY_RUN=true
MIN_CONFIDENCE=0.65

# === 主动离场（0=关闭）===
# 价格变动 %（按入场价）：杠杆 L 下对保证金影响 ≈ pct×L
EXIT_STOP_LOSS_PCT=0
EXIT_TAKE_PROFIT_PCT=0
EXIT_TRAILING_PCT=0
EXIT_MAX_HOLD_MINUTES=240
# 回报率 ROE = 收益/保证金 = 价格变动% × 杠杆。100 = 浮盈达到该仓保证金的 100% 即止盈
EXIT_TAKE_PROFIT_ROE_PCT=100
# ROE 止损：亏到保证金的该 % 即平仓（建议设，最大杠杆下逆向波动很快爆保证金）
EXIT_STOP_LOSS_ROE_PCT=80
# CoinGlass 离场（需 COINGLASS_API_KEY，否则自动跳过；不影响上面的价格/ROE 止损）
# OI 骤降离场：有浮盈时聚合 OI 变化% ≤ -此值（仓位快平=趋势衰竭）即落袋
EXIT_CG_OI_DROP_PCT=15
# 逆向资金费率护栏：做多时聚合资金费率 ≥ 此值 / 做空时 ≤ -此值（过度拥挤）即离场
EXIT_CG_ADVERSE_FUNDING=0.05

EXCHANGE_TIMEOUT_MS=30000
POSITION_POLL_INTERVAL_SEC=0.15
POSITION_POLL_TIMEOUT_SEC=5
OBSERVABILITY_HOST=127.0.0.1
OBSERVABILITY_PORT=8080
# auto=按币安账户实际持仓模式下单（单向/双向）；勿与交易所设置不一致
POSITION_MODE=auto

# === 蚂蚁仓风控：每天最多 8 笔 / 日最大亏损 10 USDT ===
MAX_TRADES_PER_DAY=8
MAX_DAILY_LOSS_USDT=10
DAILY_LOSS_WARN_RATIO=0.5
STATE_FILE=.binance_auto_ai_state.json

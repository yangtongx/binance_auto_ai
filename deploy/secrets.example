# Docker Compose secrets 目录（勿提交真实密钥；已在 .gitignore）
#
# ── 全新 Linux 云主机（零依赖，含 OpenCloudOS）────────────────────────────
#   curl -fsSL https://gitee.com/yang-huidong/binance_auto_ai/raw/master/scripts/bootstrap-server.sh | sudo bash
#   OpenCloudOS 走 dnf install docker（moby），不用 get.docker.com
#
# ── 已有 git，手动 clone 后 ───────────────────────────────────────────
#   git clone https://gitee.com/yang-huidong/binance_auto_ai.git /opt/binance_auto_ai
#   cd /opt/binance_auto_ai
#   sudo bash scripts/install-prerequisites.sh   # Docker + git + python3
#   # 写入密钥：
#   echo -n 'YOUR_BINANCE_KEY'      > secrets/binance_api_key
#   echo -n 'YOUR_BINANCE_SECRET'   > secrets/binance_api_secret
#   echo -n 'YOUR_COINGLASS_KEY'    > secrets/coinglass_api_key   # 可选
#   bash scripts/install-telegram-secrets.sh -i                   # 可选
#   chmod 600 secrets/*
#   bash scripts/deploy.sh
#
# Python 业务依赖（ccxt、pydantic、requests 等）在 docker build 时装入镜像，宿主机无需 pip install。

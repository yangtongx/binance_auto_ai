# Docker Compose secrets 目录（勿提交真实密钥；已在 .gitignore）
#
# 在服务器仓库根目录创建（单行、无换行）：
#   echo -n 'YOUR_BINANCE_KEY'      > secrets/binance_api_key
#   echo -n 'YOUR_BINANCE_SECRET'   > secrets/binance_api_secret
#   echo -n 'YOUR_COINGLASS_KEY'    > secrets/coinglass_api_key   # 可选
#   bash scripts/install-telegram-secrets.sh -i                   # Telegram 可选
#   chmod 600 secrets/*
#
# 一键部署（Linux 服务器）：
#   cd /opt/binance_auto_ai && bash scripts/deploy.sh
